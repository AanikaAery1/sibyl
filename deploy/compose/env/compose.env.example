# Compose interpolation variables. Copy to deploy/compose/.env (init-env.sh does this;
# ci/worktree.sh writes a lane-specific one with port and subnet offsets). No secrets here.
COMPOSE_PROJECT_NAME=sibyl
SIBYL_VERSION=dev
SIBYL_DB_NAME=sibyl

# Host ports (loopback only). Lane worktrees add 100 x slot.
SIBYL_PORT_HTTPS=8443
SIBYL_PORT_GATEWAY_TLS=8444
SIBYL_PORT_INGEST_TLS=8445
SIBYL_PORT_SIM=8300
SIBYL_PORT_SIM_DOUBLES=18082
SIBYL_PORT_PG=5434
SIBYL_PUBLIC_URL=https://localhost:8443

# Console data mode: live (BFF -> api) or demo (scripted fixtures, no control plane needed).
SIBYL_CONSOLE_MODE=live

# Edge network: Caddy has a pinned address that api, ingest and gateway trust for
# X-Forwarded-For (SIBYL_TRUSTED_PROXIES); the console (BFF) is pinned too and trusted by the
# api. Lane worktrees use 172.30.<slot>.0/24 (both addresses must sit in the subnet).
SIBYL_EDGE_SUBNET=172.30.0.0/24
SIBYL_CADDY_IP=172.30.0.10
SIBYL_CONSOLE_IP=172.30.0.11
# Docker's dynamic edge addresses come only from this range (inside the subnet, clear of
# the pinned .10/.11). Lane worktrees use 172.30.<slot>.128/25.
SIBYL_EDGE_IP_RANGE=172.30.0.128/25

# Saga gates (api + worker): D36 predicted-failover band ("0.90" until sibyl-sim clears the
# floors, then "0.60") and the Phase 1.5 canary failback ramp (off).
SIBYL_PREDICTED_AUTOMATION_BAND=0.90
SIBYL_FAILBACK_RAMP=false

# Optional: host path to a PEM bundle the gateway uses instead of the system store for
# upstream provider TLS (mounted read-only; empty = system trust).
SIBYL_UPSTREAM_CA_HOST_FILE=

# Optional: path to an extra CA bundle (PEM) for image builds behind a TLS-re-signing
# proxy. Build-time only; see env/README.md. Example: ~/corp-ca.pem
SIBYL_EXTRA_CA_FILE=
