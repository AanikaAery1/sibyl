# Shared by api, ingest and worker (one control image). Tunables only: every key, salt and
# password is a compose file secret granted per service (docker-compose.yml secret matrix).
#
# SIBYL_ENV=live although this is a local demo stack: D20 break-glass keys exist only as `live`
# keys and the api refuses keys whose env differs from the deployment (env_mismatch). Keep the
# gateway and sim env files on the same value. SIBYL_DEMO=1 is the safety boundary for the demo:
# provider credentials and policy snapshots are released for the sibyl-sim doubles only (R55),
# so a live-env laptop stack still cannot reach a real provider with a vaulted credential.
SIBYL_ENV=live
SIBYL_DEMO=1
SIBYL_LOG_LEVEL=info
SIBYL_LOG_FORMAT=json
SIBYL_KEK_ID=local-kek-1
# Payload blobs (ingest writes them envelope-encrypted under the KEK, B7). The default is the
# `blobstore` volume (SIBYL_BLOB_BACKEND=fs, SIBYL_BLOB_ROOT set in compose). For S3-compatible
# storage set SIBYL_BLOB_BACKEND=s3 and SIBYL_S3_BUCKET / SIBYL_S3_ENDPOINT / SIBYL_S3_REGION /
# SIBYL_S3_PREFIX / SIBYL_S3_PATH_STYLE here; the access key pair belongs in file secrets
# (SIBYL_S3_ACCESS_KEY_ID, SIBYL_S3_SECRET_ACCESS_KEY), granted like the others.
