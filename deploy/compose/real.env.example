# REAL deployment settings (deploy/compose/real.sh, `make up`). real.sh copies this, together with
# env/compose.env.example, into deploy/compose/.env.real on the first run (gitignored); edit that
# file afterwards, or export any of these variables before `make up` and real.sh writes them in.
# No secrets here: passwords, keys and salts are file secrets in env-real/secrets/ (init-env.sh).

COMPOSE_PROJECT_NAME=sibyl-real
SIBYL_CONSOLE_MODE=live

# The first tenant (workspace) and its Platform Admin (role owner, shown as "Admin").
SIBYL_TENANT_SLUG=default
SIBYL_TENANT_NAME=My organisation
SIBYL_ADMIN_EMAIL=admin@sibyl.local
# Empty (default): the admin is an invitation, bound at the first sign-in whose ID token carries
# SIBYL_ADMIN_EMAIL with email_verified=true (the bundled dex, Okta, Google, Keycloak). IdPs without
# email_verified (Entra ID): set the admin's `sub` claim at that IdP here instead.
SIBYL_ADMIN_SUBJECT=

# Capture policy set at bootstrap when the tenant has none (D12): metadata (no prompt/response
# content stored; the default), redacted (content with PII and secrets redacted), full, or none
# (set it yourself in the console's Settings; keys cannot be minted until you do).
SIBYL_BOOTSTRAP_CAPTURE_MODE=metadata

# OIDC. Empty SIBYL_OIDC_ISSUER = the bundled dex at ${SIBYL_PUBLIC_URL}/dex with one admin user.
# Your own IdP: SIBYL_OIDC_ISSUER=https://login.example.com/ (exact issuer string), register the
# redirect URI ${SIBYL_PUBLIC_URL}/api/v1/auth/callback there, and point
# SIBYL_OIDC_CLIENT_SECRET_FILE at a file holding the client secret (copied into the file secret
# oidc_client_secret by real.sh). SIBYL_OIDC_EMAIL_DOMAINS (comma list) restricts sign-in.
SIBYL_OIDC_ISSUER=
SIBYL_OIDC_CLIENT_ID=sibyl-console
SIBYL_OIDC_CLIENT_SECRET_FILE=
SIBYL_OIDC_EMAIL_DOMAINS=

# Where browsers and agents reach Sibyl. SIBYL_PUBLIC_URL empty = https://SIBYL_SITE_HOST:SIBYL_PORT_HTTPS.
SIBYL_PUBLIC_URL=
SIBYL_SITE_HOST=localhost
# 127.0.0.1 = this machine only; 0.0.0.0 = every interface (servers).
SIBYL_BIND_ADDRESS=127.0.0.1
SIBYL_PORT_HTTPS=8443
SIBYL_PORT_GATEWAY_TLS=8444
SIBYL_PORT_INGEST_TLS=8445
# Postgres, loopback only (backups). 5435 keeps clear of the demo stack's 5434.
SIBYL_PORT_PG=5435

# TLS (Caddy): internal = Caddy's local CA (trust it with `make ca`); an email address = ACME
# certificates for SIBYL_SITE_HOST (public DNS name, SIBYL_PORT_HTTPS=443, SIBYL_BIND_ADDRESS=0.0.0.0);
# or "/certs/fullchain.pem /certs/privkey.pem" with SIBYL_TLS_CERT_DIR=<host dir holding them>.
SIBYL_TLS=internal
SIBYL_TLS_CERT_DIR=

# Released images instead of local builds: SIBYL_IMAGE_TAG=1.0.0 (docker-compose.images.yml).
SIBYL_IMAGE_TAG=
SIBYL_IMAGE_REGISTRY=ghcr.io/mk-jkc

# Edge network of this project, apart from the demo stack's 172.30.0.0/24.
SIBYL_EDGE_SUBNET=172.29.0.0/24
SIBYL_CADDY_IP=172.29.0.10
SIBYL_CONSOLE_IP=172.29.0.11
SIBYL_EDGE_IP_RANGE=172.29.0.128/25
