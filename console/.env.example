# Sibyl console environment. Copy to .env.local for `npm run dev`.

# demo (default outside production): deterministic fixtures + the scripted live scenario, labelled
#       "Demo data". A production server with this unset or misspelled runs live (fails closed).
# live: real sign-in (OIDC through the API) and the BFF proxies /api/bff/* to
#       SIBYL_API_URL/api/v1/* with the session cookie as a bearer. GETs the API still answers
#       with 501 fall back to demo data, marked "Demo data" on the panel; writes never do.
SIBYL_CONSOLE_MODE=demo

# Control-plane API, reached server-side by the BFF (native dev port per ruling B2;
# compose: http://api:8000).
SIBYL_API_URL=http://localhost:8010

# Live only: comma-separated contract path templates whose READS are served by the demo engine,
# e.g. "/incidents,/queue". Writes to them are refused (409 demo_route_readonly).
SIBYL_DEMO_ROUTES=

# Live only: the `env` new API keys are minted for. Must equal the control plane's SIBYL_ENV
# (compose runs `test`). Falls back to SIBYL_ENV, then `live`.
SIBYL_KEY_ENV=

# Optional: pin the demo scenario's start time (ISO-8601) for reproducible screenshots/tests.
SIBYL_DEMO_ANCHOR=

# Live e2e only (npm run test:live): the shared Caddy origin and the dex persona password.
# SIBYL_E2E_LIVE_URL=https://localhost:8443
# SIBYL_E2E_PASSWORD=
