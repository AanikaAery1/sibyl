{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sibyl.dev/schemas/sibyl-handoff/1",
  "title": "sibyl-handoff/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packet_id",
    "tenant_id",
    "agent_id",
    "task_id",
    "created_at",
    "fidelity",
    "goal",
    "original_input",
    "completed_steps",
    "pending_steps",
    "reason",
    "next_action",
    "deadline",
    "accountability",
    "redaction",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "sibyl-handoff/1"
    },
    "packet_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "tenant_id": {
      "$ref": "#/$defs/uuid"
    },
    "agent_id": {
      "$ref": "#/$defs/uuid"
    },
    "agent_name": {
      "type": "string",
      "maxLength": 128
    },
    "task_id": {
      "$ref": "#/$defs/uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "fidelity": {
      "enum": [
        "checkpoint",
        "request_only"
      ],
      "x-sibyl-enum": "Fidelity"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "original_input": {
      "$ref": "#/$defs/output_ref"
    },
    "completed_steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/completed_step"
      }
    },
    "pending_steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pending_step"
      }
    },
    "side_effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/side_effect"
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plain_language",
        "trigger",
        "failure_mode"
      ],
      "properties": {
        "plain_language": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000
        },
        "failure_mode": {
          "$ref": "#/$defs/failure_mode"
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "sdk_explicit",
                "rule",
                "a2a_state",
                "operator",
                "approval_timeout"
              ],
              "x-sibyl-enum": "HandoffTrigger"
            },
            "rule_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,40}$"
            },
            "alert_id": {
              "$ref": "#/$defs/uuid"
            },
            "health_snapshot_id": {
              "$ref": "#/$defs/uuidv7"
            },
            "factors": {
              "type": "array",
              "items": {
                "$ref": "https://sibyl.dev/schemas/sibyl-health/1#/$defs/factor"
              }
            },
            "span_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/span_id"
              }
            },
            "call_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/uuid"
              }
            }
          }
        }
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 5,
      "maxLength": 300
    },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "derived_from"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "derived_from": {
          "enum": [
            "task_deadline",
            "tier_rto",
            "operator"
          ],
          "x-sibyl-enum": "DeadlineSource"
        },
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "rto_s": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "accountability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "line"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "on_call": {
          "type": "string"
        },
        "escalation": {
          "type": "string"
        },
        "business_process": {
          "type": "string"
        },
        "line": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_mode",
        "profile"
      ],
      "properties": {
        "capture_mode": {
          "enum": [
            "full",
            "redacted",
            "metadata"
          ],
          "x-sibyl-enum": "CaptureMode"
        },
        "profile": {
          "$ref": "https://sibyl.dev/schemas/sibyl-event/1#/$defs/redaction_profile"
        },
        "fields_redacted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assembled_by",
        "policy_version",
        "trace_ids"
      ],
      "properties": {
        "assembled_by": {
          "enum": [
            "sdk",
            "control_plane"
          ],
          "x-sibyl-enum": "AssembledBy"
        },
        "sdk_version": {
          "type": "string"
        },
        "checkpoint_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "checkpoint_seq": {
          "type": "integer",
          "minimum": 0
        },
        "checkpoint_age_s": {
          "type": "number",
          "minimum": 0
        },
        "trace_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          }
        },
        "policy_version": {
          "type": "integer",
          "minimum": 0
        },
        "transition_id": {
          "$ref": "#/$defs/uuid"
        },
        "normaliser_version": {
          "type": "string"
        }
      }
    },
    "sidecar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "route_history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at",
              "to"
            ],
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "to": {
                "$ref": "#/$defs/target"
              },
              "decision": {
                "type": "string"
              }
            }
          }
        },
        "cost_so_far_usd": {
          "type": "number",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 500
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "fidelity": {
            "const": "request_only"
          }
        }
      },
      "then": {
        "properties": {
          "pending_steps": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "assembled_by": {
                "const": "sdk"
              }
            },
            "required": [
              "assembled_by"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "properties": {
              "trigger": {
                "properties": {
                  "kind": {
                    "const": "sdk_explicit"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "span_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "failure_mode": {
      "enum": [
        "provider_outage",
        "latency_degradation",
        "quality_collapse",
        "prompt_injection",
        "policy_violation",
        "tool_failure",
        "data_source_failure",
        "infinite_loop",
        "cost_runaway",
        "permission_error",
        "model_deprecation",
        "silent_drift"
      ],
      "x-sibyl-enum": "FailureMode"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "base_url_hash": {
          "type": "string"
        },
        "agent_id": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "payload_ref": {
      "$ref": "https://sibyl.dev/schemas/sibyl-event/1#/$defs/payload_ref"
    },
    "output_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preview": {
          "type": "string",
          "maxLength": 4096
        },
        "ref": {
          "$ref": "#/$defs/payload_ref"
        },
        "content_type": {
          "type": "string"
        }
      }
    },
    "completed_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "step",
        "started_at",
        "ended_at",
        "assumed"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "step": {
          "type": "string",
          "maxLength": 128
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "tool_name": {
          "type": "string"
        },
        "call_id": {
          "$ref": "#/$defs/uuid"
        },
        "span_id": {
          "$ref": "#/$defs/span_id"
        },
        "output": {
          "$ref": "#/$defs/output_ref"
        },
        "assumed": {
          "type": "boolean"
        }
      }
    },
    "pending_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "step"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "step": {
          "type": "string",
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "inputs_needed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked_on": {
          "type": "string"
        }
      }
    },
    "side_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "at",
        "assumed"
      ],
      "properties": {
        "kind": {
          "enum": [
            "external_write",
            "message_sent",
            "payment",
            "file_written",
            "db_write",
            "ticket_created",
            "api_call",
            "unknown"
          ],
          "x-sibyl-enum": "SideEffectKind"
        },
        "target": {
          "type": "string",
          "maxLength": 256
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "idempotency_key": {
          "type": "string",
          "maxLength": 256
        },
        "reversible": {
          "type": "boolean"
        },
        "idempotent": {
          "type": "boolean",
          "description": "true only when re-running the call is safe; any other side effect is never resumed automatically (A-4)"
        },
        "assumed": {
          "type": "boolean"
        },
        "evidence_span_id": {
          "$ref": "#/$defs/span_id"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "description": "Handoff packet (API §9). Step and side-effect $defs are identical to sibyl-checkpoint/1."
}
