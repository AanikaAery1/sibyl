          ]
        },
        "tool_seq_repeat_ratio": {
          "type": [
            "number",
            "null"
          ]
        },
        "task_count": {
          "type": [
            "number",
            "null"
          ]
        },
        "task_success_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "task_steps_p95": {
          "type": [
