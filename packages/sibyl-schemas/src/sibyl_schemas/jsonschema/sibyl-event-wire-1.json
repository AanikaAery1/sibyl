{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sibyl.dev/schemas/sibyl-event-wire/1",
  "title": "sibyl-event-wire/1 (POST /v1/events element)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "type",
    "tenant_id",
    "agent_id",
    "ts",
    "source",
    "emitter_id",
    "seq",
    "capture_mode",
    "redaction_profile",
    "policy_state",
    "attrs"
  ],
  "properties": {
    "schema": {
      "const": "sibyl-event/1"
    },
    "event_id": {
      "$ref": "#/$defs/uuidv7"
    },
    "type": {
      "enum": [
        "gen_ai.request",
        "tool.call",
        "agent.invoke",
        "checkpoint",
        "handoff.requested",
        "handoff.completed",
        "handoff.returned",
        "feedback",
        "task.outcome",
        "agent.discovered",
        "policy.decision",
        "observation.gap",
        "provider.status",
        "health.transition"
      ],
      "x-sibyl-enum": "EventType"
    },
    "tenant_id": {
      "$ref": "#/$defs/uuid"
    },
    "agent_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "call_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "span_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "parent_span_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "Emitter clock; for spans, the span end time"
    },
    "source": {
      "enum": [
        "sdk",
        "gateway",
        "ingest",
        "worker",
        "api"
      ],
      "x-sibyl-enum": "EventSource"
    },
    "emitter_id": {
      "type": "string",
      "maxLength": 128,
      "description": "Stable per process instance: '<source>:<host>:<pid>' or gateway replica id"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic per emitter_id; replay keeps original seq"
    },
    "capture_mode": {
      "enum": [
        "full",
        "redacted",
        "metadata"
      ],
      "x-sibyl-enum": "CaptureMode"
    },
    "redaction_profile": {
      "$ref": "#/$defs/redaction_profile"
    },
    "policy_state": {
      "$ref": "#/$defs/policy_state"
    },
    "attrs": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "not": {
              "enum": [
                "provider.status",
                "observation.gap"
              ],
              "x-sibyl-enum": "EventType",
              "x-sibyl-enum-subset": "condition"
            }
          }
        }
      },
      "then": {
        "properties": {
          "agent_id": {
            "$ref": "#/$defs/uuid"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "gen_ai.request"
          }
        }
      },
      "then": {
        "properties": {
          "attrs": {
            "$ref": "#/$defs/attrs_gen_ai_request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool.call"
          }
        }
      },
      "then": {
        "properties": {
          "attrs": {
            "$ref": "#/$defs/attrs_tool_call"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent.invoke"
          }
        }
      },
      "then": {
        "properties": {
          "attrs": {
            "$ref": "#/$defs/attrs_agent_invoke"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "checkpoint"
          }
        }
      },
      "then": {
        "properties": {
          "attrs": {
            "$ref": "#/$defs/attrs_checkpoint"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "handoff.requested"
          }
        }
      },
      "then": {
        "properties": {
          "attrs": {
            "$ref": "#/$defs/attrs_handoff_requested"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "handoff.completed",
              "handoff.returned"
            ],
            "x-sibyl-enum": "EventType",
            "x-sibyl-enum-subset": "condition"
          }
        }
      },
      "then": {
        "properties": {
          "attrs": {
            "$ref": "#/$defs/attrs_handoff_resolved"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "feedback"
          }
        }
      },
      "then": {
        "properties": {
          "attrs": {
            "$ref": "#/$defs/attrs_feedback"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "task.outcome"
          }
        }
      },
      "then": {
        "properties": {
          "attrs": {
            "$ref": "#/$defs/attrs_task_outcome"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent.discovered"
          }
        }
      },
      "then": {
        "properties": {
          "attrs": {
            "$ref": "#/$defs/attrs_agent_discovered"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "policy.decision"
          }
        }
      },
      "then": {
        "properties": {
          "attrs": {
            "$ref": "#/$defs/attrs_policy_decision"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "observation.gap"
          }
        }
      },
      "then": {
        "properties": {
          "attrs": {
            "$ref": "#/$defs/attrs_observation_gap"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "provider.status"
          }
        }
      },
      "then": {
        "properties": {
          "attrs": {
            "$ref": "#/$defs/attrs_provider_status"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "health.transition"
          }
        }
      },
      "then": {
        "properties": {
          "attrs": {
            "$ref": "#/$defs/attrs_health_transition"
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "money": {
      "type": "number",
      "minimum": 0
    },
    "failure_mode": {
      "enum": [
        "provider_outage",
        "latency_degradation",
        "quality_collapse",
        "prompt_injection",
        "policy_violation",
        "tool_failure",
        "data_source_failure",
        "infinite_loop",
        "cost_runaway",
        "permission_error",
        "model_deprecation",
        "silent_drift"
      ],
      "x-sibyl-enum": "FailureMode"
    },
    "rule_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,40}$",
      "description": "Open, additive registry (sibyl_schemas.values.RuleId): error_rate, p95_latency, consecutive_failures, provider_status, budget_breach, refusal_share, truncation_share, schema_fail_share, heartbeat_missing, tool_loop, quality_proxy, error_trend, latency_trend, ratelimit_proximity, budget_proximity, fallback_pressure, refusal_trend, continuity_unverified, context_saturation, credential_expiry, model_deprecation, drift_cusum, anomaly_score"
    },
    "redaction_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "secrets_scrubbed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "'secrets_only' is the unconditional floor; tenant profiles (e.g. pii_standard) add rules"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "rules_fired": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "secrets_scrubbed": {
          "type": "integer",
          "minimum": 0
        },
        "fields_redacted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "profile_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sibyl.redaction.profile_hash"
        },
        "emitter_profile_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Emitter's hash when ingest applied a stricter profile"
        },
        "late_hits": {
          "type": "integer",
          "minimum": 0,
          "description": "Secrets ingest found that the emitter missed (sibyl.redaction.late_hits)"
        }
      }
    },
    "policy_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "fresh",
            "stale",
            "expired",
            "unavailable",
            "not_applicable"
          ],
          "x-sibyl-enum": "PolicyState"
        },
        "policy_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "fail_mode": {
          "enum": [
            "open",
            "closed",
            null
          ],
          "x-sibyl-enum": "FailMode"
        },
        "snapshot_age_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "payload_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256",
        "bytes",
        "content_type"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^blob://[0-9a-f-]{36}/\\d{4}-\\d{2}-\\d{2}/[A-Za-z0-9_./-]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Of the plaintext after redaction, before compression and encryption"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "content_type": {
          "type": "string"
        },
        "parts": {
          "type": "array",
          "items": {
            "enum": [
              "input_messages",
              "output_messages",
              "system_instructions",
              "tool_definitions",
              "tool_args",
              "tool_result",
              "state",
              "raw_span",
              "comment",
              "original_input"
            ],
            "x-sibyl-enum": "PayloadPart"
          }
        },
        "redaction_profile": {
          "$ref": "#/$defs/redaction_profile"
        },
        "truncated": {
          "type": "boolean",
          "description": "sibyl.payload.truncated (tail-first)"
        },
        "bytes_original": {
          "type": "integer",
          "minimum": 0,
          "description": "Size before truncation"
        }
      }
    },
    "raw_span_ref": {
      "type": "object",
      "required": [
        "source",
        "trace_id",
        "span_id",
        "ref"
      ],
      "properties": {
        "source": {
          "enum": [
            "sdk",
            "gateway",
            "otel"
          ],
          "x-sibyl-enum": "TelemetrySource"
        },
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "ref": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "base_url_hash": {
          "type": "string",
          "description": "sha256 prefix of the allowlisted base_url; never the URL"
        },
        "agent_id": {
          "$ref": "#/$defs/uuid",
          "description": "Set when the target is a backup agent"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_creation_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "enum": [
            "provider",
            "estimated"
          ],
          "x-sibyl-enum": "UsageSource"
        }
      }
    },
    "attrs_gen_ai_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "provider",
        "request_model",
        "status",
        "latency_ms",
        "contributions",
        "merge_state"
      ],
      "properties": {
        "operation": {
          "enum": [
            "chat",
            "text_completion",
            "embeddings",
            "generate_content"
          ],
          "x-sibyl-enum": "GenAiOperation"
        },
        "provider": {
          "type": "string",
          "description": "gen_ai.provider.name value, e.g. openai, anthropic, ollama"
        },
        "request_model": {
          "type": "string"
        },
        "response_model": {
          "type": "string"
        },
        "response_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "error"
          ],
          "x-sibyl-enum": "CallStatus"
        },
        "error_type": {
          "type": "string",
          "description": "OTel error.type: HTTP status as string, exception class, or 'timeout'"
        },
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "ttfb_ms": {
          "type": "number",
          "minimum": 0
        },
        "streamed": {
          "type": "boolean"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "cost_usd": {
          "$ref": "#/$defs/money"
        },
        "cost_source": {
          "type": "string",
          "description": "price table id and version, e.g. prices/2026-10-01"
        },
        "finish_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "temperature": {
              "type": "number"
            },
            "top_p": {
              "type": "number"
            },
            "top_k": {
              "type": "integer"
            },
            "max_tokens": {
              "type": "integer"
            },
            "seed": {
              "type": "integer"
            },
            "stop_sequences": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "frequency_penalty": {
              "type": "number"
            },
            "presence_penalty": {
              "type": "number"
            },
            "choice_count": {
              "type": "integer"
            },
            "output_type": {
              "enum": [
                "text",
                "json",
                "image",
                "speech"
              ],
              "x-sibyl-enum": "OutputType"
            },
            "service_tier": {
              "type": "string"
            },
            "tool_definitions_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "tool_calls_requested": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model_context_limit": {
              "type": "integer",
              "minimum": 1
            },
            "utilisation": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Derived: input_tokens / model_context_limit"
            }
          }
        },
        "ratelimit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limit_requests": {
              "type": "integer"
            },
            "remaining_requests": {
              "type": "integer"
            },
            "reset_requests_ms": {
              "type": "integer"
            },
            "limit_tokens": {
              "type": "integer"
            },
            "remaining_tokens": {
              "type": "integer"
            },
            "reset_tokens_ms": {
              "type": "integer"
            },
            "headroom": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Derived: min(remaining/limit) across requests and tokens"
            }
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempt"
          ],
          "properties": {
            "attempt": {
              "type": "integer",
              "minimum": 1
            },
            "inline_fallback_used": {
              "type": "boolean"
            },
            "fallback_target": {
              "$ref": "#/$defs/target"
            },
            "breaker_state": {
              "enum": [
                "closed",
                "open",
                "half_open"
              ],
              "x-sibyl-enum": "BreakerState"
            }
          }
        },
        "route": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision"
          ],
          "properties": {
            "decision": {
              "enum": [
                "primary",
                "failover",
                "inline_fallback",
                "canary",
                "stale_primary"
              ],
              "x-sibyl-enum": "RouteDecision"
            },
            "reason": {
              "type": "string"
            },
            "from": {
              "$ref": "#/$defs/target"
            },
            "to": {
              "$ref": "#/$defs/target"
            },
            "transition_id": {
              "$ref": "#/$defs/uuid"
            }
          }
        },
        "server": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            }
          }
        },
        "conversation_id": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string",
          "description": "Declared version, else sha256 prefix of system instructions"
        },
        "data_source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "payload": {
          "$ref": "#/$defs/payload_ref"
        },
        "content_hashes": {
          "type": "object",
          "properties": {
            "input": {
              "$ref": "#/$defs/sha256"
            },
            "output": {
              "$ref": "#/$defs/sha256"
            },
            "system": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "output_chars": {
          "type": "integer",
          "minimum": 0
        },
        "eval_sample": {
          "type": "boolean"
        },
        "contributions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "sdk",
              "gateway",
              "otel"
            ],
            "x-sibyl-enum": "TelemetrySource"
          }
        },
        "merge_state": {
          "enum": [
            "partial",
            "complete"
          ],
          "x-sibyl-enum": "MergeState"
        },
        "policy_sdk_version": {
          "type": "integer",
          "minimum": 0,
          "description": "SDK's last-seen policy version when the gateway's differs (API §8.6)"
        },
        "cost_unpriced": {
          "type": "boolean",
          "description": "No price row matched at ingest"
        },
        "capture_override_rejected": {
          "type": "boolean",
          "description": "X-Sibyl-Capture asked for a looser mode and was ignored"
        },
        "system_fingerprint": {
          "type": "string",
          "maxLength": 128,
          "description": "Provider fingerprint of the serving backend (OpenAI system_fingerprint)."
        },
        "parent_run_id": {
          "$ref": "#/$defs/uuid",
          "description": "Run tree: the run (task) that directly contains this node."
        },
        "step_index": {
          "type": "integer",
          "minimum": 0,
          "description": "Run tree: 0-based order of this node within its parent run."
        },
        "payload_inline": {
          "$ref": "#/$defs/payload_inline"
        }
      }
    },
    "attrs_tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "tool_type",
        "status",
        "latency_ms"
      ],
      "properties": {
        "tool_name": {
          "type": "string"
        },
        "tool_type": {
          "enum": [
            "function",
            "mcp",
            "a2a",
            "http",
            "retrieval",
            "code",
            "extension",
            "datastore"
          ],
          "x-sibyl-enum": "ToolType"
        },
        "tool_call_id": {
          "type": "string"
        },
        "mcp_server": {
          "type": "string"
        },
