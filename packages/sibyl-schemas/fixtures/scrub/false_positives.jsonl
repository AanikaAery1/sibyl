{"id": "fp-01", "field": "input_messages", "text": "Please quote 40 pallets for order A-88213, delivery to Pune by 15 Oct."}
{"id": "fp-02", "field": "input_messages", "text": "The password policy requires at least 12 characters and one digit."}
