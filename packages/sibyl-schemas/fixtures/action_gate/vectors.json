    {
      "name": "refund_within_burst_escalates",
      "policy": "payments",
      "tool": "payments.refund",
      "args": {
        "customer_id": "c-1",
        "amount": 10
      },
      "counters": {
        "0192767f-0000-7000-8000-0000000ac001/refund-burst/0b9cf8425cdbbc6264610862e4e91670": 3
      },
      "expected": {
        "effect": "escalate",
        "rule_id": "refund-burst",
        "needs_counter": true
      }
    },
    {
      "name": "unknown_payment_tool_sensitive_default",
      "policy": "payments",
      "tool": "payments.void",
