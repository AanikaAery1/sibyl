        "effect": "allow",
        "rule_id": "transfer-daily-cap",
        "needs_counter": true
      }
    },
    {
      "name": "negative_amount_cannot_drain_cap",
      "policy": "payments",
      "tool": "payments.transfer",
      "args": {
        "to_account": "ACC-77",
        "currency": "INR",
        "amount": -40000
      },
      "counters": {
        "0192767f-0000-7000-8000-0000000ac001/transfer-daily-cap": 0
      },
      "expected": {
        "effect": "escalate",
        "rule_id": "transfer-daily-cap"
      }
    },
    {
      "name": "missing_destination_default",
      "policy": "payments",
      "tool": "payments.transfer",
      "args": {
        "currency": "USD",
