{
  "description": "Action Gate decision vectors (sibyl_schemas.action_gate.evaluate). Every enforcement point (SDK, gateway, control-plane simulate) must reproduce effect and rule_id. counters hold the window total before the call, keyed by counter_key(policy, rule, args).",
  "policies": {
    "payments": {
      "schema": "sibyl-action-policy/1",
      "policy_id": "0192767f-0000-7000-8000-0000000ac001",
      "version": 3,
      "default_effect": "escalate",
      "tool_allowlist_enforced": true,
      "tool_allowlist": [
        "payments.*",
        "crm.lookup",
        "email.send",
        "search.*"
      ],
      "sensitive_tools": [
        "payments.*"
      ],
      "external_tools": [
        "email.send"
      ],
      "hold_timeout_s": 900,
      "rules": [
        {
          "rule_id": "transfer-over-limit",
          "tool": "payments.transfer",
          "when": {
            "gt": [
              "/amount",
              10000
            ]
          },
          "effect": "block",
          "reason": "Transfers above 10,000 are not authorised for this agent"
        },
        {
          "rule_id": "transfer-currency",
          "tool": "payments.transfer",
          "when": {
            "not": {
              "in": [
                "/currency",
                [
                  "INR",
                  "USD"
                ]
              ]
            }
          },
          "effect": "block",
          "reason": "Only INR and USD transfers are allowed"
        },
        {
          "rule_id": "transfer-daily-cap",
          "tool": "payments.transfer",
          "when": {
            "all": [
              {
                "exists": "/to_account"
              },
              {
                "le": [
                  "/amount",
                  10000
                ]
              }
            ]
          },
          "cumulative": {
            "sum": "/amount",
            "max": 50000,
            "window_s": 86400
          },
          "effect": "allow",
          "reason": "Within the per-transfer limit and the 50,000 daily cap"
        },
        {
          "rule_id": "refund-burst",
          "tool": "payments.refund",
          "cumulative": {
            "count": true,
            "max": 20,
            "window_s": 60,
            "per": "/customer_id",
            "on_exceed": "block"
          },
          "effect": "escalate",
          "reason": "Refunds need a person; more than 20 a minute per customer is blocked"
        },
        {
          "rule_id": "no-pii-out",
          "tool": "email.send",
          "data_class": {
            "secrets": true,
            "pii": [
              "credit_card",
              "iban",
              "national_id"
            ]
          },
          "effect": "block",
          "reason": "Card, bank and national ids never leave by email"
        },
        {
          "rule_id": "email-internal-only",
          "tool": "email.send",
          "when": {
            "matches": [
              "/to",
              "[A-Za-z0-9._%+-]+@meridian\\.example"
            ]
          },
          "effect": "allow",
          "reason": "Internal recipients only"
        },
        {
          "rule_id": "reads",
          "tool": "search.*",
          "effect": "allow",
          "reason": "Searches are read-only"
        },
        {
          "rule_id": "crm",
          "tool": "crm.lookup",
          "effect": "allow",
          "reason": "Lookups are read-only"
        }
      ]
    },
    "open": {
      "schema": "sibyl-action-policy/1",
      "policy_id": "0192767f-0000-7000-8000-0000000ac002",
      "version": 1,
      "default_effect": "allow",
      "tool_allowlist_enforced": false,
      "tool_allowlist": null,
      "sensitive_tools": [],
      "external_tools": [
        "http.*"
      ],
      "hold_timeout_s": 300,
      "rules": [
        {
          "rule_id": "exfil",
          "tool": "*",
          "data_class": {
            "secrets": true,
            "pii": [
              "email",
              "phone",
              "credit_card",
              "iban",
              "national_id"
            ]
          },
          "effect": "block",
          "reason": "No secrets or personal data to external endpoints"
        }
      ]
    }
  },
  "cases": [
    {
      "name": "over_limit_transfer",
      "policy": "payments",
      "tool": "payments.transfer",
      "args": {
        "to_account": "ACC-77",
        "currency": "INR",
        "amount": 25000
      },
      "expected": {
        "effect": "block",
        "rule_id": "transfer-over-limit",
        "matched_paths": [
          "/amount"
        ]
      },
      "scenarios": [
        "over_limit_blocked"
      ]
    },
    {
      "name": "over_limit_as_string",
      "policy": "payments",
      "tool": "payments.transfer",
      "args": {
        "to_account": "ACC-77",
        "currency": "INR",
        "amount": "25000.00"
      },
      "expected": {
        "effect": "block",
        "rule_id": "transfer-over-limit",
        "matched_paths": [
          "/amount"
        ]
      }
    },
    {
      "name": "type_confused_amount",
      "policy": "payments",
      "tool": "payments.transfer",
      "args": {
        "to_account": "ACC-77",
        "currency": "INR",
        "amount": "twenty thousand"
      },
      "expected": {
        "effect": "block",
        "rule_id": "transfer-over-limit",
        "matched_paths": [
          "/amount"
        ]
      }
    },
    {
      "name": "wrong_currency",
      "policy": "payments",
      "tool": "payments.transfer",
      "args": {
        "to_account": "ACC-77",
        "currency": "EUR",
        "amount": 100
      },
      "expected": {
        "effect": "block",
        "rule_id": "transfer-currency",
        "matched_paths": [
          "/currency"
        ]
      }
    },
    {
      "name": "under_limit_counter_pending",
      "policy": "payments",
      "tool": "payments.transfer",
      "args": {
        "to_account": "ACC-77",
        "currency": "INR",
        "amount": 9000
      },
      "expected": {
        "effect": "escalate",
        "rule_id": "transfer-daily-cap",
        "needs_counter": true
