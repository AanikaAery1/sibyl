      "expected": {
        "effect": "allow",
        "rule_id": "transfer-daily-cap",
        "matched_paths": [
          "/to_account",
          "/amount"
        ],
        "needs_counter": true
      },
      "scenarios": [
        "under_limit_allowed"
      ]
    },
    {
      "name": "daily_cap_exceeded",
      "policy": "payments",
      "tool": "payments.transfer",
      "args": {
        "to_account": "ACC-77",
        "currency": "INR",
        "amount": 9000
      },
      "counters": {
        "0192767f-0000-7000-8000-0000000ac001/transfer-daily-cap": 45000
