    },
    {
      "name": "under_limit_within_cap",
      "policy": "payments",
      "tool": "payments.transfer",
      "args": {
        "to_account": "ACC-77",
        "currency": "INR",
        "amount": 9000
      },
      "counters": {
        "0192767f-0000-7000-8000-0000000ac001/transfer-daily-cap": 12000
