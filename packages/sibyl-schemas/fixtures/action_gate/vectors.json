      "expected": {
        "effect": "escalate",
        "rule_id": "transfer-daily-cap"
      },
      "scenarios": [
        "cumulative_escalates"
      ]
    },
    {
      "name": "daily_cap_exactly_reached",
      "policy": "payments",
      "tool": "payments.transfer",
      "args": {
        "to_account": "ACC-77",
        "currency": "INR",
        "amount": 5000
      },
      "counters": {
        "0192767f-0000-7000-8000-0000000ac001/transfer-daily-cap": 45000
      },
